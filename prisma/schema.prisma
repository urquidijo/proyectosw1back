generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum SqlImportStatus {
  VALID
  INVALID
}

enum GenerationEngine {
  POSTGRESQL
  MONGODB
}

/** Sintaxis del script DDL que el usuario pega/sube (no confundir con GenerationEngine, que es el motor destino de los datos generados). */
enum SqlDialect {
  POSTGRESQL
  MYSQL
}

enum PlanType {
  INDIVIDUAL
  GROUP
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]

  subscriptionPlanId   String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  apiKey               String?  @unique
  plan                 SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  workspaces         WorkspaceMember[]
  ownedWorkspaces    Workspace[]       @relation("WorkspaceOwner")
  payments           PaymentLog[]
  activities         ActivityLog[]
  communityPosts     CommunityPost[]
  postComments       PostComment[]
  postUpvotes        PostUpvote[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  isPublic    Boolean    @default(false)

  sqlImports SqlImport[]

  generations Generation[]

  generationPlans GenerationPlan[]

  generationRuleSets GenerationRuleSet[]

  communityPosts     CommunityPost[]

  @@map("projects")
}

model SqlImport {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalSql String
  status      SqlImportStatus
  schemaJson  Json?
  errors      Json?
  engine      GenerationEngine @default(POSTGRESQL)
  dialect     SqlDialect       @default(POSTGRESQL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  generations Generation[]

  generationPlan GenerationPlan?

  generationRuleSets GenerationRuleSet[]

  @@map("sql_imports")
}

model Generation {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sqlImportId String
  sqlImport   SqlImport @relation(fields: [sqlImportId], references: [id], onDelete: Cascade)

  generationRuleSetId String?
  generationRuleSet   GenerationRuleSet? @relation(fields: [generationRuleSetId], references: [id], onDelete: SetNull)

  rowConfig      Json
  previewJson    Json
  outputSql      String?
  status         String   @default("COMPLETED")
  progress       Int      @default(100)
  error          String?
  outputFile     String?
  outputDataFile String?
  region         String?
  engine         GenerationEngine @default(POSTGRESQL)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  validationJson Json?

  @@map("generations")
}

model GenerationPlan {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sqlImportId String    @unique
  sqlImport   SqlImport @relation(fields: [sqlImportId], references: [id], onDelete: Cascade)
  planJson    Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("generation_plans")
}

model GenerationRuleSet {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sqlImportId String
  sqlImport   SqlImport @relation(fields: [sqlImportId], references: [id], onDelete: Cascade)

  name        String
  description String?
  rulesJson   Json
  isDefault   Boolean @default(false)
  isPublic    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations Generation[]

  @@unique([projectId, sqlImportId, name])
  @@index([projectId])
  @@index([sqlImportId])
  @@map("generation_rule_sets")
}

model SubscriptionPlan {
  id                     String   @id @default(cuid())
  name                   String   @unique
  type                   PlanType @default(INDIVIDUAL)
  price                  Decimal  @default(0.0)
  maxWorkspaces          Int      @default(1)
  maxProjects            Int      @default(5)
  maxUsersPerWorkspace   Int?
  maxGenerationsPerMonth Int      @default(10)
  apiCostPer1kRows       Decimal?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  users                  User[]

  @@map("subscription_plans")
}

model Workspace {
  id                 String           @id @default(cuid())
  name               String
  ownerId            String
  createdAt          DateTime         @default(now())

  owner              User             @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members            WorkspaceMember[]
  projects           Project[]
  activities         ActivityLog[]
  payments           PaymentLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model PaymentLog {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  amount      Decimal
  currency    String   @default("USD")
  status      String
  reference   String?
  createdAt   DateTime @default(now())

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@map("payment_logs")
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String?  
  userId      String?  
  action      String   
  details     Json?    
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// ===========================
// Community Models
// ===========================

model CommunityPost {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  tags        String[]

  // Archivo SQL en AWS S3
  fileKey     String?
  imageKey    String?

  // Enlace opcional a proyecto existente
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  downloads   Int      @default(0)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments    PostComment[]
  upvotes     PostUpvote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@map("community_posts")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.Text

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@map("post_comments")
}

model PostUpvote {
  id        String   @id @default(cuid())
  postId    String
  userId    String

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("post_upvotes")
}
